# Configure at runtime, preferably from Google Secret Manager. Never commit values.
GEMINI_API_KEY=
LINGOLIVE_ACCESS_TOKEN=
LINGOLIVE_FLASH_MODEL=gemini-3.6-flash
LINGOLIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# Recommended on Cloud Run: no Google API key; use the runtime service account.
# LINGOLIVE_PROVIDER=vertex
# LINGOLIVE_VERTEX_PROJECT=YOUR_PROJECT_ID
# LINGOLIVE_VERTEX_LOCATION=global
# Runtime IAM needs aiplatform.endpoints.predict and serviceusage.services.use.

# Private-demo usage guards; counters reset when the instance restarts.
LINGOLIVE_AI_ENABLED=true
LINGOLIVE_REQUESTS_PER_MINUTE=24
LINGOLIVE_LESSONS_PER_HOUR=360
LINGOLIVE_LESSONS_PER_DAY=400
LINGOLIVE_AUDIO_SECONDS_PER_HOUR=2400
LINGOLIVE_AUDIO_SECONDS_PER_DAY=3600
LINGOLIVE_MAX_OUTPUT_TOKENS=4096

# Google sign-in requires a registered Web application client (public ID, no secret).
# Do not enable before registration; required mode with missing config fails closed.
LINGOLIVE_GOOGLE_SIGNIN_REQUIRED=false
LINGOLIVE_GOOGLE_CLIENT_ID=
# Comma-separated explicit invitation list; required mode denies all when empty.
LINGOLIVE_ALLOWED_GOOGLE_EMAILS=

# Allow short server-memory sessions using a learner's own AI Studio key.
LINGOLIVE_BYOK_ENABLED=true
